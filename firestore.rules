rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Allow users to read their friends' basic profiles
      match /friends/{friendId} {
        allow read: if request.auth != null;
      }
    }
    
    // Allow users to read and write their own shopping list
    match /shopping_lists/{itemId} {
      // For creating new documents, we can't check resource.data.userId because it doesn't exist yet
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // For reading, updating, and deleting, we check the existing document's userId
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Fridges rules
    match /fridges/{fridgeId} {
      // Check if user is owner or contributor
      function isOwnerOrContributor() {
        return request.auth != null && (
          resource.data.ownerId == request.auth.uid || 
          resource.data.contributors.hasAny([request.auth.uid])
        );
      }
      
      // Owner can perform all operations
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.ownerId == request.auth.uid || 
        resource.data.contributors.hasAny([request.auth.uid])
      );
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
    
    // Fridge items rules
    match /fridge_items/{itemId} {
      // Need to get the fridgeId from the item to check permissions
      function getFridgeId() {
        return resource.data.fridgeId;
      }
      
      function canAccessFridge(fridgeId) {
        let fridge = get(/databases/$(database)/documents/fridges/$(fridgeId)).data;
        return fridge.ownerId == request.auth.uid || fridge.contributors.hasAny([request.auth.uid]);
      }
      
      // Allow users to create items in fridges they have access to
      allow create: if request.auth != null && 
        canAccessFridge(request.resource.data.fridgeId);
      
      // Allow read/update/delete for items in fridges users have access to
      allow read, update, delete: if request.auth != null && 
        canAccessFridge(resource.data.fridgeId);
    }
    
    // Test collection - allow access for testing purposes
    match /test/{document=**} {
      allow read, write: if true;
    }

    match /friend_requests/{requestId} {
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      allow read: if request.auth != null && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow update: if request.auth != null && resource.data.receiverId == request.auth.uid;
      allow delete: if false;
    }
  }
} 